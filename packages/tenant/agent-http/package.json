{
  "name": "@deepseek-ai/dsh-agent-http",
  "description": "Multi-tenant agent HTTP carrier: bearer auth + request-scoped tenant authority over the existing ctx.apiProxy fetch surface",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/tenant/agent-http"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-host-apiproxy": "workspace:^",
    "@deepseek-ai/dsh-host-webserver": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-tenant": "workspace:^",
    "@deepseek-ai/dsh-tenant-auth": "workspace:^",
    "@deepseek-ai/dsh-tenant-questions": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-host-apiproxy": "workspace:^",
    "@deepseek-ai/dsh-host-webserver": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-tenant": "workspace:^",
    "@deepseek-ai/dsh-tenant-auth": "workspace:^",
    "@deepseek-ai/dsh-tenant-auth-jwt": "workspace:^",
    "@deepseek-ai/dsh-tenant-questions": "workspace:^",
    "@deepseek-ai/dsh-user-questions": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "jose": "^5.9.6"
  },
  "dependencies": {
    "swagger-ui-dist": "^5.32.15",
    "zod": "^4.4.3"
  }
}
