{
  "name": "@deepseek-ai/dsh-tenant-admin-http",
  "description": "Tenant-administration HTTP carrier: the management surface (/admin) gated by the administrative scope alone, serving tenant CRUD, member admission, and user-tier provisioning",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/tenant/tenant-admin-http"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-host-webserver": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-skill": "workspace:^",
    "@deepseek-ai/dsh-skill-install": "workspace:^",
    "@deepseek-ai/dsh-tenant": "workspace:^",
    "@deepseek-ai/dsh-tenant-admin": "workspace:^",
    "@deepseek-ai/dsh-tenant-auth": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-host-webserver": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-skill": "workspace:^",
    "@deepseek-ai/dsh-skill-filesystem": "workspace:^",
    "@deepseek-ai/dsh-skill-install": "workspace:^",
    "@deepseek-ai/dsh-skill-tier": "workspace:^",
    "@deepseek-ai/dsh-tenant": "workspace:^",
    "@deepseek-ai/dsh-tenant-admin": "workspace:^",
    "@deepseek-ai/dsh-tenant-auth": "workspace:^",
    "@deepseek-ai/dsh-tenant-auth-jwt": "workspace:^",
    "fflate": "^0.8.2",
    "jose": "^5.9.6"
  }
}
