{
  "name": "@deepseek-ai/dsh-multi-tenant",
  "description": "The multi-tenant dsh backend as a profile bundle: a patch layer over dsh-base and dsh-web-app that swaps the local execution world for the tenant container runtime and mounts the tenant registry / auth / agent-http carrier",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/multi-tenant"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-http": "workspace:^",
    "@deepseek-ai/dsh-bash-local": "workspace:^",
    "@deepseek-ai/dsh-code-runtime-container": "workspace:^",
    "@deepseek-ai/dsh-container-docker": "workspace:^",
    "@deepseek-ai/dsh-credentials-postgres": "workspace:^",
    "@deepseek-ai/dsh-fs-container": "workspace:^",
    "@deepseek-ai/dsh-session-persistence-postgres": "workspace:^",
    "@deepseek-ai/dsh-settings-postgres": "workspace:^",
    "@deepseek-ai/dsh-settings-tier": "workspace:^",
    "@deepseek-ai/dsh-skill-tier": "workspace:^",
    "@deepseek-ai/dsh-storage-postgres": "workspace:^",
    "@deepseek-ai/dsh-subprocess-container": "workspace:^",
    "@deepseek-ai/dsh-tenant": "workspace:^",
    "@deepseek-ai/dsh-tenant-auth-jwt": "workspace:^",
    "@deepseek-ai/dsh-tools-manifest": "workspace:^",
    "@deepseek-ai/dsh-tools-tier": "workspace:^",
    "@deepseek-ai/dsh-workflow-container": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}