# deepseek-harness（多租户宿主 + 沙箱授权 + 工作区数据卷）。
NS_DSH=dsh
TAG=
IMG_TENANT=dsh-tenant
IMG_TOOL_EXEC=dsh-tool-exec
NP_TENANT=30788
SVC_TENANT=dsh-tenant
# ClusterIP=仅集群内；NodePort=对外（此时 NP_TENANT 生效，nodePort 行自动加/去）
SVC_TENANT_TYPE=ClusterIP
REPLICAS_TENANT=1
PVC_DSH_WS=dsh-workspace
SC_RWX=rook-cephfs
SIZE_DSH_WS=30Gi
SA_DSH=dsh-host
SECRET_LLM=dsh-llm-secret
SECRET_TENANT=dsh-tenant-secret
SECRET_TENANT_CONFIG=dsh-tenant-config
CM_MCP_PATCH=dsh-mcp-client-patch
SVC_DSH_PG=dsh-pg
DSH_PG_USER=dsh
DSH_PG_PASSWORD=
DSH_PG_DB=dsh
CEPH_RGW_ENDPOINT=http://rook-ceph-rgw-dsh-objectstore.rook-ceph.svc:80
