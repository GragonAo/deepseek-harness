# dsh 租户宿主（docker/docker-compose.tenant.yml）的环境变量模板。
#
# 用法：
#   cp docker/.env.example docker/.env        # 然后填 DSH_TENANT_OIDC_SECRET
#   bash docker/build-images.sh               # compose 自己不构建镜像，先建镜像
#   cp docker/tenant.config.example.yaml docker/tenant.config.yaml
#   docker compose -f docker/docker-compose.tenant.yml up -d
#
# 关于这个文件的位置（已实测）：`docker compose -f docker/docker-compose.tenant.yml` 的项目目录
# 就是 `docker/`，所以放在 `docker/.env` 会被**自动加载**，无需 export、也无需 --env-file。
# 想换位置就显式加 `--env-file <路径>`。
#
# `docker/.env` 与本仓根的 `.env` 是两件事：根的 `.env` 供 real-API 测试与 dsh CLI 读
# DEEPSEEK_API_KEY，这份只管 tenant compose。两者都在 .gitignore 里。

# ===== 必填 ==================================================================
# 租户 token 的签名密钥，必须与签发方（jeecg 侧）共享同一个值，否则签出来的 token 验不过。
# 不给这个变量时 compose 会直接以 "需要设置 DSH_TENANT_OIDC_SECRET" 拒绝渲染。
# 生成：openssl rand -hex 32
DSH_TENANT_OIDC_SECRET=

# ===== 可选 ==================================================================
# 部署级兜底 LLM key。凭据解析顺序是「继承环境 > 按 (租户,用户) 的 PG 存储 > .env」，
# 空值等同未设置，所以留空不会挡住运营按租户单独配 key。
DEEPSEEK_API_KEY=

# Postgres 镜像。默认 pgvector/pgvector:pg16 —— 租户库要用向量类型，别换成普通 postgres 镜像。
POSTGRES_IMAGE=pgvector/pgvector:pg16

# Postgres 口令。默认值 dsh-local 仅供本地联调，且端口只发布到 127.0.0.1；
# 正式部署必须显式设置。
POSTGRES_PASSWORD=dsh-local

# 宿主端口。宿主 5432 已被占用时改这里，并同步改 tenant.config.yaml 里的 connectionString。
POSTGRES_PORT=5432

# 挂进容器的配置文件路径。默认 ./tenant.config.yaml 相对 docker/ 目录，
# 与上面 `cp docker/tenant.config.example.yaml docker/tenant.config.yaml` 对应。
# 注意：换成绝对路径时，宿主的文件必须在容器里以同一路径可见（见 compose 文件头的硬约束 2）。
TENANT_CONFIG_FILE=./tenant.config.yaml
